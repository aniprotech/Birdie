NODE_ENV=development
HOST=127.0.0.1
PORT=9000
FRONTEND_URL=https://caremonitor.aniprotech.com
CORS_ORIGINS=https://caremonitor.aniprotech.com
TRUST_PROXY=true
# Embedded PostgreSQL for local development. Set DB_DRIVER=postgres for a server.
DB_DRIVER=pglite
PGLITE_DATA_DIR=./data/postgres
DATABASE_URL=
JWT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://backend.aniprotech.com/api/auth/microsoft/callback
UPLOAD_DIR=./uploads
# Local files only; no email is sent in outbox mode.
MAIL_MODE=outbox
OUTBOX_DIR=./outbox
# Railway Hobby blocks SMTP. Use Resend's HTTPS API in production.
RESEND_API_KEY=
RESEND_FROM=AniProTech <login@your-verified-domain.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SHARE_ACCESS_URL=https://caremonitor.aniprotech.com/shared-access
INBOX_NOTIFICATIONS_ENABLED=true
