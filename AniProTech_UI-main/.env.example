VITE_APP_BASE_LIVE_URL=https://backend.aniprotech.com
# Browser API keys are public. Restrict this key to the production web origins
# and only the Google APIs used by https://caremonitor.aniprotech.com.
VITE_APP_MAP_API_KEY=
VITE_APP_SECRET_KEY=replace-with-a-random-application-storage-key
# Optional verified public business details for Organization search markup.
# Leave blank until each value is accurate and intended for public display.
VITE_PUBLIC_PHONE=
VITE_PUBLIC_STREET_ADDRESS=
VITE_PUBLIC_CITY=
VITE_PUBLIC_REGION=
VITE_PUBLIC_POSTCODE=
VITE_PUBLIC_COUNTRY_CODE=
VITE_PUBLIC_SOCIAL_URLS=
